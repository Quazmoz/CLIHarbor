{
  "schemaVersion": "cliharbor.packtest/v1",
  "cases": [
    {
      "name": "show active docker context",
      "packId": "docker-cli",
      "commandId": "context",
      "expectArgs": [
        "context",
        "show"
      ]
    },
    {
      "name": "docker version",
      "packId": "docker-cli",
      "commandId": "version",
      "expectArgs": [
        "version",
        "--format",
        "json"
      ]
    },
    {
      "name": "list containers safely",
      "packId": "docker-cli",
      "commandId": "containers",
      "expectArgs": [
        "container",
        "ls",
        "--all",
        "--format",
        "table {{.ID}}\\t{{.Names}}\\t{{.Image}}\\t{{.State}}\\t{{.Status}}\\t{{.Ports}}"
      ]
    },
    {
      "name": "list images safely",
      "packId": "docker-cli",
      "commandId": "images",
      "expectArgs": [
        "image",
        "ls",
        "--all",
        "--format",
        "table {{.ID}}\\t{{.Repository}}\\t{{.Tag}}\\t{{.Size}}"
      ]
    },
    {
      "name": "list networks safely",
      "packId": "docker-cli",
      "commandId": "networks",
      "expectArgs": [
        "network",
        "ls",
        "--format",
        "table {{.ID}}\\t{{.Name}}\\t{{.Driver}}\\t{{.Scope}}\\t{{.IPv6}}\\t{{.Internal}}"
      ]
    },
    {
      "name": "list volumes safely",
      "packId": "docker-cli",
      "commandId": "volumes",
      "expectArgs": [
        "volume",
        "ls",
        "--format",
        "table {{.Name}}\\t{{.Driver}}\\t{{.Scope}}"
      ]
    },
    {
      "name": "show docker disk usage summary",
      "packId": "docker-cli",
      "commandId": "disk-usage",
      "expectArgs": [
        "system",
        "df"
      ]
    },
    {
      "name": "show one-shot container resource snapshot",
      "packId": "docker-cli",
      "commandId": "container-stats",
      "expectArgs": [
        "container",
        "stats",
        "--no-stream",
        "--format",
        "table {{.ID}}\\t{{.Name}}\\t{{.CPUPerc}}\\t{{.MemUsage}}\\t{{.NetIO}}\\t{{.BlockIO}}"
      ]
    }
  ]
}
