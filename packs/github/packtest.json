        "path": "values.limit"
      }
    },
    {
      "name": "pull-requests requires explicit repository",
      "packId": "github-cli",
      "commandId": "pull-requests",
      "values": {
        "limit": 30,
        "state": "open"
      },
      "expectError": {
        "code": "missing_input",
        "path": "values.repository"
      }
    },
    {
      "name": "pull-requests rejects repository flag injection",
      "packId": "github-cli",
      "commandId": "pull-requests",
      "values": {
        "repository": "--help",
        "limit": 30,
        "state": "open"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.repository"
      }
    },
    {
      "name": "pull-requests rejects repository URL",
      "packId": "github-cli",
      "commandId": "pull-requests",
      "values": {
        "repository": "https://example.invalid/sample-org/sample-repo",
        "limit": 30,
        "state": "open"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.repository"
      }
    },
