{
  "schemaVersion": "cliharbor.packtest/v1",
  "cases": [
    {
      "name": "local version",
      "packId": "github-cli",
      "commandId": "version",
      "values": {},
      "expectArgs": [
        "--version"
      ]
    },
    {
      "name": "bounded repository inventory",
      "packId": "github-cli",
      "commandId": "repositories",
      "values": {
        "owner": "sample-org",
        "limit": 30
      },
      "expectArgs": [
        "repo",
        "list",
        "sample-org",
        "--limit",
        "30",
        "--json",
        "nameWithOwner,isPrivate,isArchived,url"
      ]
    },
    {
      "name": "pull-requests open",
      "packId": "github-cli",
      "commandId": "pull-requests",
      "values": {
        "repository": "sample-org/sample-repo",
        "limit": 30,
        "state": "open"
      },
      "expectArgs": [
        "pr",
        "list",
        "--repo",
        "sample-org/sample-repo",
        "--limit",
        "30",
        "--state",
        "open",
        "--json",
        "number,state,isDraft,createdAt,updatedAt,url"
      ]
    },
    {
      "name": "pull-requests closed",
      "packId": "github-cli",
      "commandId": "pull-requests",
      "values": {
        "repository": "sample-org/sample-repo",
        "limit": 30,
        "state": "closed"
      },
      "expectArgs": [
        "pr",
        "list",
        "--repo",
        "sample-org/sample-repo",
        "--limit",
        "30",
        "--state",
        "closed",
        "--json",
        "number,state,isDraft,createdAt,updatedAt,url"
      ]
    },
