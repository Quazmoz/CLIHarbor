        "sample-org/sample-repo",
        "--limit",
        "30",
        "--state",
        "all",
        "--json",
        "number,state,createdAt,updatedAt,url"
      ]
    },
    {
      "name": "runs metadata",
      "packId": "github-cli",
      "commandId": "runs",
      "values": {
        "repository": "sample-org/sample-repo",
        "limit": 30
      },
      "expectArgs": [
        "run",
        "list",
        "--repo",
        "sample-org/sample-repo",
        "--limit",
        "30",
        "--json",
        "databaseId,event,status,conclusion,createdAt,updatedAt,url"
      ]
    },
    {
      "name": "workflows metadata",
      "packId": "github-cli",
      "commandId": "workflows",
      "values": {
        "repository": "sample-org/sample-repo",
