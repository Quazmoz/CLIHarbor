        "sample-org/sample-repo",
        "--limit",
        "30",
        "--json",
        "id,name,state"
      ]
    },
    {
      "name": "include disabled workflows",
      "packId": "github-cli",
      "commandId": "workflows",
      "values": {
        "repository": "sample-org/sample-repo",
        "limit": 100,
        "all": true
      },
      "expectArgs": [
        "workflow",
        "list",
        "--repo",
        "sample-org/sample-repo",
        "--limit",
        "100",
        "--all",
        "--json",
        "id,name,state"
      ]
    },
    {
      "name": "repositories rejects limit 0",
      "packId": "github-cli",
      "commandId": "repositories",
      "values": {
        "owner": "sample-org",
        "limit": 0
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.limit"
      }
    },
    {
      "name": "repositories rejects limit 101",
      "packId": "github-cli",
      "commandId": "repositories",
      "values": {
        "owner": "sample-org",
        "limit": 101
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.limit"
      }
    },
    {
      "name": "reject owner flag injection",
      "packId": "github-cli",
      "commandId": "repositories",
      "values": {
        "owner": "--help",
        "limit": 30
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.owner"
      }
    },
    {
      "name": "reject owner shell syntax",
      "packId": "github-cli",
      "commandId": "repositories",
      "values": {
        "owner": "sample;whoami",
        "limit": 30
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.owner"
      }
    },
    {
      "name": "repositories rejects browser argv",
      "packId": "github-cli",
      "commandId": "repositories",
      "values": {
        "owner": "sample-org",
        "limit": 30,
        "argv": [
          "auth",
          "token"
        ]
      },
      "expectError": {
        "code": "unknown_input",
        "path": "values.argv"
      }
    },
    {
      "name": "pull-requests rejects limit 0",
      "packId": "github-cli",
      "commandId": "pull-requests",
