{
  "schemaVersion": "cliharbor.packtest/v1",
  "cases": [
    {
      "name": "safe detailed inspection",
      "packId": "example",
      "commandId": "inspect",
      "values": {
        "limit": 5,
        "verbose": true,
        "mode": "detailed"
      },
      "expectArgs": [
        "inspect",
        "--limit",
        "5",
        "--verbose",
        "--detailed-mode"
      ]
    },
    {
      "name": "safe minimal inspection",
      "packId": "example",
      "commandId": "inspect",
      "values": {
        "mode": "safe"
      },
      "expectArgs": [
        "inspect",
        "--safe-mode"
      ]
    },
    {
      "name": "reject limit below minimum",
      "packId": "example",
      "commandId": "inspect",
      "values": {
        "limit": 0,
        "mode": "safe"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.limit"
      }
    },
    {
      "name": "reject limit above maximum",
      "packId": "example",
      "commandId": "inspect",
      "values": {
        "limit": 1001,
        "mode": "safe"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.limit"
      }
    },
    {
      "name": "reject unknown mode",
      "packId": "example",
      "commandId": "inspect",
      "values": {
        "mode": "unknown"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.mode"
      }
    },
    {
      "name": "default streaming duration",
      "packId": "example",
      "commandId": "wait",
      "values": {},
      "expectArgs": [
        "wait"
      ]
    },
    {
      "name": "bounded streaming duration",
      "packId": "example",
      "commandId": "wait",
      "values": {
        "seconds": 2
      },
      "expectArgs": [
        "wait",
        "--seconds",
        "2"
      ]
    },
    {
      "name": "reject streaming duration below minimum",
      "packId": "example",
      "commandId": "wait",
      "values": {
        "seconds": 0
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.seconds"
      }
    },
    {
      "name": "reject streaming duration above maximum",
      "packId": "example",
      "commandId": "wait",
      "values": {
        "seconds": 61
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.seconds"
      }
    },
    {
      "name": "deliberate nonzero exit",
      "packId": "example",
      "commandId": "fail",
      "values": {},
      "expectArgs": [
        "fail"
      ]
    }
  ]
}
