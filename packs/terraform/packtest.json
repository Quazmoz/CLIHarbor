{
  "schemaVersion": "cliharbor.packtest/v1",
  "cases": [
    {
      "name": "offline Terraform version",
      "packId": "terraform-cli",
      "commandId": "version",
      "values": {},
      "expectArgs": [
        "version"
      ]
    },
    {
      "name": "top level Terraform CLI help",
      "packId": "terraform-cli",
      "commandId": "command-reference",
      "values": {},
      "expectArgs": [
        "help"
      ]
    },
    {
      "name": "provider command help only",
      "packId": "terraform-cli",
      "commandId": "provider-reference",
      "values": {},
      "expectArgs": [
        "providers",
        "-help"
      ]
    },
    {
      "name": "formatting command help only",
      "packId": "terraform-cli",
      "commandId": "formatting-reference",
      "values": {},
      "expectArgs": [
        "fmt",
        "-help"
      ]
    },
    {
      "name": "refuse project directory injection",
      "packId": "terraform-cli",
      "commandId": "provider-reference",
      "values": {
        "chdir": "/secrets"
      },
      "expectError": {
        "code": "unknown_input",
        "path": "values.chdir"
      }
    },
    {
      "name": "refuse terraform apply arguments",
      "packId": "terraform-cli",
      "commandId": "command-reference",
      "values": {
        "argv": [
          "apply",
          "-auto-approve"
        ]
      },
      "expectError": {
        "code": "unknown_input",
        "path": "values.argv"
      }
    },
    {
      "name": "refuse reading terraform state file",
      "packId": "terraform-cli",
      "commandId": "formatting-reference",
      "values": {
        "stateFile": "terraform.tfstate"
      },
      "expectError": {
        "code": "unknown_input",
        "path": "values.stateFile"
      }
    },
    {
      "name": "refuse choosing cloud backend",
      "packId": "terraform-cli",
      "commandId": "version",
      "values": {
        "backend": "remote"
      },
      "expectError": {
        "code": "unknown_input",
        "path": "values.backend"
      }
    },
    {
      "name": "refuse undeclared Terraform init",
      "packId": "terraform-cli",
      "commandId": "init",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform validate",
      "packId": "terraform-cli",
      "commandId": "validate",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform plan",
      "packId": "terraform-cli",
      "commandId": "plan",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform apply",
      "packId": "terraform-cli",
      "commandId": "apply",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform destroy",
      "packId": "terraform-cli",
      "commandId": "destroy",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform state",
      "packId": "terraform-cli",
      "commandId": "state",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "show init help without executing init",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "init"
      },
      "expectArgs": [
        "init",
        "-help"
      ]
    },
    {
      "name": "show validate help without executing validate",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "validate"
      },
      "expectArgs": [
        "validate",
        "-help"
      ]
    },
    {
      "name": "show plan help without executing plan",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "plan"
      },
      "expectArgs": [
        "plan",
        "-help"
      ]
    },
    {
      "name": "show apply help without executing apply",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "apply"
      },
      "expectArgs": [
        "apply",
        "-help"
      ]
    },
    {
      "name": "show destroy help without executing destroy",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "destroy"
      },
      "expectArgs": [
        "destroy",
        "-help"
      ]
    },
    {
      "name": "show workspace help without executing workspace",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "workspace"
      },
      "expectArgs": [
        "workspace",
        "-help"
      ]
    },
    {
      "name": "show state help without executing state",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "state"
      },
      "expectArgs": [
        "state",
        "-help"
      ]
    },
    {
      "name": "show output help without executing output",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "output"
      },
      "expectArgs": [
        "output",
        "-help"
      ]
    },
    {
      "name": "workflow selection required",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {},
      "expectError": {
        "code": "missing_input",
        "path": "values.workflow"
      }
    },
    {
      "name": "unknown workflow rejected",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "terraform-plan"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.workflow"
      }
    },
    {
      "name": "workflow flag injection rejected",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "--auto-approve"
      },
      "expectError": {
        "code": "invalid_input",
        "path": "values.workflow"
      }
    },
    {
      "name": "workflow does not accept browser flags",
      "packId": "terraform-cli",
      "commandId": "workflow-reference",
      "values": {
        "workflow": "plan",
        "chdir": "../production"
      },
      "expectError": {
        "code": "unknown_input",
        "path": "values.chdir"
      }
    },
    {
      "name": "refuse undeclared Terraform workspace",
      "packId": "terraform-cli",
      "commandId": "workspace",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform output",
      "packId": "terraform-cli",
      "commandId": "output",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform fmt",
      "packId": "terraform-cli",
      "commandId": "fmt",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "refuse undeclared Terraform providers",
      "packId": "terraform-cli",
      "commandId": "providers",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "list local state resource addresses",
      "packId": "terraform-cli",
      "commandId": "local-state-resources",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "dry-run targeted local state removal",
      "packId": "terraform-cli",
      "commandId": "local-state-forget-preview",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "approve local state detachment with lock and backup",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "state list requires explicit file",
      "packId": "terraform-cli",
      "commandId": "local-state-resources",
      "values": {},
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "dry-run requires resource address",
      "packId": "terraform-cli",
      "commandId": "local-state-forget-preview",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "state mutation requires file",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "address": "module.app.aws_instance.server[\"blue\"]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "state mutation requires address",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject relative state path",
      "packId": "terraform-cli",
      "commandId": "local-state-resources",
      "values": {
        "state-file": "./terraform.tfstate"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject traversal state path",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/tmp/../infra/terraform.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject remote backend URL",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "https://host/state.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject non-state filename",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/credentials.json",
        "address": "module.app.aws_instance.server[\"blue\"]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject shell-like resource flag",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "--lock=false"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject whitespace and compound address",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "aws_instance.vm;terraform destroy"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject unknown state command parameter",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]",
        "argv": [
          "-lock=false"
        ]
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject browser-selected backup override",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]",
        "backup": "/tmp/backup"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject browser dry-run skip flag",
      "packId": "terraform-cli",
      "commandId": "local-state-forget-preview",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "module.app.aws_instance.server[\"blue\"]",
        "dry-run": false
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "reject malformed Terraform address punctuation",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "module.prod.*"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "dry-run rejects leading dash resource address",
      "packId": "terraform-cli",
      "commandId": "local-state-forget-preview",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "-lock=false"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "state listing accepts Windows absolute state path",
      "packId": "terraform-cli",
      "commandId": "local-state-resources",
      "values": {
        "state-file": "C:\\Users\\operator\\terraform.tfstate"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    },
    {
      "name": "state detach accepts numbered instance address",
      "packId": "terraform-cli",
      "commandId": "local-state-forget",
      "values": {
        "state-file": "/home/operator/project/terraform.tfstate",
        "address": "aws_instance.worker[0]"
      },
      "expectError": {
        "code": "unknown_command",
        "path": "commandId"
      }
    }
  ]
}
